# Copy to .env and adjust. Never commit .env.

# dev | test | prod
ENV=dev
LOG_LEVEL=INFO

# Docker Postgres is published on host port 5433 (a local Postgres usually owns 5432).
# If 5433 is busy on your machine, set POSTGRES_HOST_PORT (read by docker compose) and the URLs below.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://mandy:mandy@localhost:5433/mandy
TEST_DATABASE_URL=postgresql+asyncpg://mandy:mandy@localhost:5433/mandy_test
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# The frontend (http://localhost:3001) proxies /api/v1 to this API.
CORS_ORIGINS=["http://localhost:3001"]

# WebAuthn (passkeys). RP_ID must match the frontend's host; ORIGIN is the frontend origin.
RP_ID=localhost
RP_NAME=Mandy
ORIGIN=http://localhost:3001

# DEV ONLY: enables POST /api/v1/auth/dev-login (signs in the owner without a passkey).
# Only registered when ENV=dev. Never enable in production.
DEV_LOGIN_ENABLED=true

# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
# Leave empty to disable AI endpoints (they return 503 AI_UNAVAILABLE).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pull real RSS feeds on POST /news/refresh
NEWS_FEEDS_ENABLED=true
